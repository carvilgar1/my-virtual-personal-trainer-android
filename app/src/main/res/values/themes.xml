<resources>
    <!-- Base application theme. -->
    <style name="Theme.MyVirtualPersonalTrainer" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="android:textColorPrimary">@color/blue_1</item>
        <item name="android:textColorSecondary">@color/inverted_blue_1</item>
        <item name="colorPrimary">@color/blue_1</item>
        <item name="colorPrimaryVariant">@color/blue_2</item>
        <item name="colorOnPrimary">@color/blue_3</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/gray_1</item>
        <item name="colorSecondaryVariant">@color/gray_2</item>
        <item name="colorOnSecondary">@color/gray_3</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.MyVirtualPersonalTrainer.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MyVirtualPersonalTrainer.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.MyVirtualPersonalTrainer.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>